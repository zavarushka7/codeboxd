rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users ──
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ── usernames (резервирование @handle) ──
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      // РАЗРЕШАЕМ удалить свой username — нужно при смене handle
      // (старый документ удаляется в транзакции saveProfile).
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── follows ──
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.followerId == request.auth.uid
                    && request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isSignedIn()
                    && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ── items ──
    match /items/{itemId} {
      allow read: if isSignedIn();
      // Разрешаем обновлять только агрегаты рейтинга.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ratingSum', 'ratingCount', 'averageRating']);
      allow create, delete: if false;
    }

    // ── collections ──
    match /collections/{collectionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── favourites ──
    match /favourites/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ── reviews ──
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && (
             resource.data.userId == request.auth.uid
             || request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['likes', 'dislikes'])
           );
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }
    }

    // ── reactions ──
    match /reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── feeds (fan-out лента) ──
    match /feeds/{ownerUid}/items/{itemId} {
      // Владелец читает свою ленту.
      allow read: if isSignedIn() && request.auth.uid == ownerUid;

      // Запись — только от имени actorUid == auth.uid.
      // Клиент пишет в чужие ленты (fan-out), поэтому ownerUid != auth.uid
      // допустим, но actorUid обязан совпадать с auth.uid.
      allow create, update: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid;

      // Удалять элементы ленты может только Cloud Function (admin SDK).
      allow delete: if false;
    }

    // ── suggestions (заявки на добавление айтемов) ──
    // Клиент может ТОЛЬКО создавать заявку от своего имени.
    // Чтение/модерация — вручную через консоль Firebase или Admin SDK
    // (Cloud Function / админ-скрипт), поэтому read/update/delete = false.
    match /suggestions/{suggestionId} {
      allow read: if false;

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.status == "PENDING";

      allow update, delete: if false;
    }
  }
}
